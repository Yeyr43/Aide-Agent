Screen {
    background: #0c0c0c;
}

#session-label {
    height: 1;
    padding: 0 2;
    background: #0c0c0c;
    color: #888888;
}

#messages {
    height: 1fr;
    padding: 1 2;
    scrollbar-size: 0 0;
}

.user-message {
    /* 纵向 margin 折叠为相邻两者较大值：
       下 1 → 消息与自己的树紧贴 1 行；
       上 2 → 与上一棵树的下边距 4 折叠后拉开 4 行（避免钉住消息与下一消息框冲突）。
       总高（含 margin）= 3，与 .sticky-header 对齐保证钉住位移抵消 */
    margin: 2 0 1 0;
    background: #0c0c0c;
    color: #c8c8c0;
}

.turn-tree {
    height: auto;              /* 随内容生长：否则 Vertical 默认 1fr 填充视口，长正文被裁剪、不可滚动 */
    margin: 0 0 4 0;           /* 上 0（紧贴消息下边距 1 行）；下 4 提供与下一消息的 4 行间距 */
}

.sticky-header {
    dock: top;                 /* 滚动容器内固定：不随内容滚动，也不计入 virtual_size */
    display: none;             /* 未钉住时隐藏（display:none → 无 dock 间距，布局零扰动） */
    margin: 0 0 3 0;           /* 总高（含 margin）== .user-message 的 2+1=3：dock 间距 == 被钉消息占位，位移抵消 */
                               /* 上边距 0 → 钉住消息紧贴顶部（比 .user-message 上移两行） */
}

.tree-guide {
    color: #555555;
    height: 1;
    /* 用 padding 而非 margin 缩进：margin 会让 widget 区域左边缘落在列 11，
       树滚到钉住框背后时该处产生 compositor cut，切断框内跨列 11 的双宽 CJK
       字符（"题"→空白）。padding 保持视觉缩进，但区域左边缘回到列 2（与消息框
       左缘一致），不再产生列 11 的 cut。 */
    margin: 0;
    padding-left: 9;
}

.tree-node {
    /* 同上：padding 缩进避免树区域左边缘产生列 11 的 cut，破坏钉住框内容 */
    margin: 0;
    padding-left: 9;
    color: #c8c8c0;
}

#bottom-area {
    dock: bottom;
    height: auto;
    background: #0c0c0c;
}

#input {
    margin: 0 0 1 0;          /* 贴左：占满整行（去掉左右 margin） */
    width: 100%;
    border: solid #555555;
    background: #121212;
    color: #c8c8c0;
    max-height: 5;
    scrollbar-size: 0 0;
    padding: 0 1;
}

#input:focus { border: solid #c8c8c0; }
#input.maintenance { border: solid #e0c878; }

CommandPalette {
    display: none;
    height: auto;
    max-height: 7;
    margin: 0 0 0 0;           /* 与输入框对齐，整行 */
    border: solid #555555;
    background: #121212;
    padding: 0 1;
    scrollbar-size: 0 0;
}

CommandPalette.-visible { display: block; }

CommandPalette ListView {
    height: auto;
    max-height: 6;
    background: #121212;
}

CommandPalette ListView > ListItem {
    padding: 0 1;
    color: #888888;
}

CommandPalette ListView > ListItem.-highlight {
    background: #1a2a3a;
    color: #c8c8c0;
}

CommandPalette Static { color: #888888; }

#status-bar {
    dock: bottom;
    height: 1;
    background: #0c0c0c;
    color: #888888;
    padding: 0 2;
}

#status-left {
    width: 1fr;
    overflow: hidden;
}

#status-right {
    width: auto;
}
