Screen {
    background: #0c0c0c;
}

#session-label {
    height: 1;
    padding: 0 2;
    background: #0c0c0c;
    color: #888888;
}

#messages {
    height: 1fr;
    padding: 1 2;
    scrollbar-size: 0 0;
}

.user-message {
    margin: 1 0 2 9;          /* 与树对齐（右移一格）+ 底部留空一行 */
    background: #0c0c0c;
    color: #c8c8c0;
}

.turn-tree {
    height: auto;              /* 随内容生长：否则 Vertical 默认 1fr 填充视口，长正文被裁剪、不可滚动 */
    margin: 0 0 1 0;
}

.tree-guide {
    color: #555555;
    height: 1;
    margin: 0 0 0 9;           /* │ 引导列：与节点行的 │ 同列 */
}

.tree-node {
    margin: 0 0 0 9;           /* 树内容右移一格：│ 单列，● 单列，文本单列 */
    color: #c8c8c0;
}

#bottom-area {
    dock: bottom;
    height: auto;
    background: #0c0c0c;
}

#input {
    margin: 0 0 1 0;          /* 贴左：占满整行（去掉左右 margin） */
    width: 100%;
    border: solid #555555;
    background: #121212;
    color: #c8c8c0;
    max-height: 5;
    scrollbar-size: 0 0;
    padding: 0 1;
}

#input:focus { border: solid #c8c8c0; }
#input.maintenance { border: solid #e0c878; }

CommandPalette {
    display: none;
    height: auto;
    max-height: 7;
    margin: 0 0 0 0;           /* 与输入框对齐，整行 */
    border: solid #555555;
    background: #121212;
    padding: 0 1;
    scrollbar-size: 0 0;
}

CommandPalette.-visible { display: block; }

CommandPalette ListView {
    height: auto;
    max-height: 6;
    background: #121212;
}

CommandPalette ListView > ListItem {
    padding: 0 1;
    color: #888888;
}

CommandPalette ListView > ListItem.-highlight {
    background: #1a2a3a;
    color: #c8c8c0;
}

CommandPalette Static { color: #888888; }

#status-bar {
    dock: bottom;
    height: 1;
    background: #0c0c0c;
    color: #888888;
    padding: 0 2;
}

#status-left {
    width: 1fr;
    overflow: hidden;
}

#status-right {
    width: auto;
}
